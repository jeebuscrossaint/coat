# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# Generated by coat, pulled in from ~/.config/tofi/config via `include=coat-theme`.
# Colours, font and font size only — geometry, padding, num-results, prompt text
# and behaviour are yours. tofi resolves an include the moment it reads the line,
# so anything after it in your config overrides what is here.

{% if font_monospace %}font = {{ font_monospace }}
font-size = {{ font_size_popups }}
{% endif %}
background-color = #{{ base00 }}
outline-color = #{{ base00 }}
border-color = #{{ base0D }}
text-color = #{{ base05 }}
prompt-color = #{{ base0D }}
input-color = #{{ base05 }}
placeholder-color = #{{ base03 }}
default-result-color = #{{ base05 }}
selection-color = #{{ base0D }}
selection-match-color = #{{ base0A }}
selection-background = #{{ base02 }}
text-cursor-color = #{{ base0D }}
