# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# An edit list, not a config file:
#
#     <section>  <key>  <value>
#
# coat patches these keys into ~/.config/fnott/fnott.ini in place and leaves every
# other line alone. fnott has no include mechanism, so coat used to own the whole
# file -- margins, timeouts, anchor, stacking order and all -- and a theme change
# quietly reset anything the user had tuned. Those are not colours, so they are
# not coat's.
#
# fnott's colours are RGBA -- alpha LAST (rrggbbaa), per fnott.ini(5). Getting this
# backwards parses `ff181818` as red ff, green 18, blue 18: every notification comes
# out pink. It is not an error either way, just wrong colours, so the only way to
# catch it is to look.

main    title-font          {{ font_monospace }}:size={{ font_size_popups }}
main    summary-font        {{ font_monospace }}:size={{ font_size_popups }}
main    body-font           {{ font_monospace }}:size={{ font_size_popups }}
main    background          {{ base00 }}ff
main    border-color        {{ base03 }}ff
main    title-color         {{ base0D }}ff
main    summary-color       {{ base05 }}ff
main    body-color          {{ base05 }}ff
main    progress-bar-color  {{ base0D }}ff

low     title-color         {{ base03 }}ff
low     border-color        {{ base03 }}ff

normal  title-color         {{ base0D }}ff
normal  border-color        {{ base03 }}ff

critical  title-color       {{ base08 }}ff
critical  border-color      {{ base08 }}ff
critical  background        {{ base00 }}ff
