# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# Generated by coat. fnott has no include mechanism, so coat owns this whole
# file. Geometry lives in coat's templates/fnott.tera -- edits here are lost on
# the next `coat set`.
#
# fnott's colours are RGBA -- alpha LAST (rrggbbaa), per fnott.ini(5): "in RGBA
# format", default 3f5f3fff. I had this backwards on the first pass and wrote
# alpha first, which meant `ff181818` was parsed as red ff, green 18, blue 18:
# every notification came out pink. It is not an error either way, just wrong
# colours, so the only way to catch it is to look.

[main]
notification-margin=8
edge-margin-vertical=10
edge-margin-horizontal=10
border-size=1
border-radius=0
max-width=420
max-height=200
{% if font_monospace %}title-font={{ font_monospace }}:size={{ font_size_popups }}
summary-font={{ font_monospace }}:size={{ font_size_popups }}
body-font={{ font_monospace }}:size={{ font_size_popups }}
{% endif %}
background={{ base00 }}ff
border-color={{ base03 }}ff
title-color={{ base0D }}ff
summary-color={{ base05 }}ff
body-color={{ base05 }}ff
progress-bar-height=4
progress-bar-color={{ base0D }}ff
default-timeout=5
idle-timeout=0
anchor=top-right
stacking-order=top-down
layer=overlay

[low]
title-color={{ base03 }}ff
border-color={{ base03 }}ff
default-timeout=3

[normal]
title-color={{ base0D }}ff
border-color={{ base03 }}ff

[critical]
title-color={{ base08 }}ff
border-color={{ base08 }}ff
background={{ base00 }}ff
# 0 = never expire. A critical notification you miss is one that did not happen.
default-timeout=0
