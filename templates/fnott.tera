# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# Generated by coat. fnott has no include mechanism, so coat owns this whole
# file. Geometry lives in coat's templates/fnott.tera -- edits here are lost on
# the next `coat set`.
#
# fnott's colours are ARGB with the alpha FIRST (aarrggbb), which is the opposite
# of the rrggbbaa every other Wayland tool here uses. Getting it backwards gives
# you a fully transparent popup rather than an error.

[main]
notification-margin=8
edge-margin-vertical=10
edge-margin-horizontal=10
border-size=1
border-radius=0
max-width=420
max-height=200
{% if font_monospace %}title-font={{ font_monospace }}:size={{ font_size_popups }}
summary-font={{ font_monospace }}:size={{ font_size_popups }}
body-font={{ font_monospace }}:size={{ font_size_popups }}
{% endif %}
background=ff{{ base00 }}
border-color=ff{{ base03 }}
title-color=ff{{ base0D }}
summary-color=ff{{ base05 }}
body-color=ff{{ base05 }}
progress-bar-height=4
progress-bar-color=ff{{ base0D }}
default-timeout=5
idle-timeout=0
anchor=top-right
stacking-order=top-down
layer=overlay

[low]
title-color=ff{{ base03 }}
border-color=ff{{ base03 }}
default-timeout=3

[normal]
title-color=ff{{ base0D }}
border-color=ff{{ base03 }}

[critical]
title-color=ff{{ base08 }}
border-color=ff{{ base08 }}
background=ff{{ base00 }}
# 0 = never expire. A critical notification you miss is one that did not happen.
default-timeout=0
