/* coat theme: {{ scheme_name }}
 * {{ scheme_author }}
{% if scheme_variant %} * variant: {{ scheme_variant }}
{% endif %} *
 * Generated by coat -- do not edit. dwl is configured at compile time, so this
 * header is included by config.def.h and the tree is rebuilt on apply.
 *
 * Colour choice mirrors the sway module's client.* mapping: only base00, base03,
 * base05 and base08 are used. base01/02/04/06 are avoided on purpose -- plenty of
 * published schemes fill them with saturated ANSI colours, which would put a neon
 * frame on unfocused windows. base05-on-base00 and base03-on-base00 are the only
 * pairs base16 guarantees are legible. Focus is signalled by brightness, never hue.
 */

#define COAT_THEMED 1

/* dwl colours are 0xRRGGBBAA */
#define COAT_BASE00 0x{{ base00 | lower }}ff
#define COAT_BASE03 0x{{ base03 | lower }}ff
#define COAT_BASE05 0x{{ base05 | lower }}ff
#define COAT_BASE08 0x{{ base08 | lower }}ff
#define COAT_BASE0D 0x{{ base0D | lower }}ff

/* fg, bg, border -- consumed by colors[][3] in config.def.h.
 *
 * These three elements serve two different consumers, which is why fg and
 * border disagree: the BAR uses fg/bg (status text, layout symbol, tag
 * numbers, window title), while WINDOW BORDERS use only the border element.
 * So each is matched to its sway counterpart independently -- fg follows the
 * swaybar module, border follows the sway module's client.* mapping.
 *
 * Backgrounds stay at base00 throughout, as in the swaybar module: tags render
 * as bare accent-coloured numbers rather than filled pills.
 */

/* status text, layout symbol, unselected tags, unfocused title (swaybar
 * statusline is base05); border is the unfocused window frame (base03) */
#define COAT_NORM_FG     COAT_BASE05
#define COAT_NORM_BG     COAT_BASE00
#define COAT_NORM_BORDER COAT_BASE03

/* selected tag and focused title take the accent, matching swaybar's
 * focused_workspace; the border stays base05, matching client.focused */
#define COAT_SEL_FG      COAT_BASE0D
#define COAT_SEL_BG      COAT_BASE00
#define COAT_SEL_BORDER  COAT_BASE05

/* urgent: base08 text on base00, not a filled block */
#define COAT_URG_FG      COAT_BASE08
#define COAT_URG_BG      COAT_BASE00
#define COAT_URG_BORDER  COAT_BASE08

/* root (the desktop behind the windows) -- COLOR() wants floats, so give the
 * components rather than the packed value */
#define COAT_ROOTCOLOR COAT_BASE00

{% if font_monospace %}/* bar font, fcft syntax */
#define COAT_FONT "{{ font_monospace }}:size={{ font_size_desktop }}"
{% endif %}
