/* coat theme: {{ scheme_name }}
 * {{ scheme_author }}
{% if scheme_variant %} * variant: {{ scheme_variant }}
{% endif %} *
 * Generated by coat -- do not edit. mew is configured at compile time, so this
 * header is included by config.def.h and the tree is rebuilt on apply.
 *
 * Mirrors the tofi module's palette so the launcher looks the same after the
 * swap: base0D is the accent (selection), base05 text on base00 ground.
 */

#define COAT_THEMED 1

/* mew colours are 0xRRGGBBAA, as {fg, bg} pairs */
#define COAT_NORM_FG 0x{{ base05 | lower }}ff
#define COAT_NORM_BG 0x{{ base00 | lower }}ff

#define COAT_SEL_FG  0x{{ base00 | lower }}ff
#define COAT_SEL_BG  0x{{ base0D | lower }}ff

#define COAT_OUT_FG  0x{{ base00 | lower }}ff
#define COAT_OUT_BG  0x{{ base0B | lower }}ff

{% if font_monospace %}#define COAT_FONT "{{ font_monospace }}:size={{ font_size_popups }}"
{% endif %}
