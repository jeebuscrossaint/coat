-- coat theme: {{ scheme_name }}
-- {{ scheme_author }}
{% if scheme_variant %}-- variant: {{ scheme_variant }}{% endif %}
--
-- Generated by coat, for a Lua Hyprland config:
--
--     local c = require("coat-colors")
--     hl.config({ general = { col = { inactive_border = c.base03 } } })
--
-- The hyprlang config sources coat-theme.conf instead. Both files are written on
-- every apply, so switching between a .conf and a .lua config needs no coat change.
--
-- Colours are hyprlang rgba() strings rather than 0xAARRGGBB integers: Hyprland's
-- Lua bindings accept the string form everywhere a colour is taken, and it is the
-- one spelling that also works inside a gradient table.

return {
    base00 = "rgba({{ base00 | lower_hex }}ff)",
    base01 = "rgba({{ base01 | lower_hex }}ff)",
    base02 = "rgba({{ base02 | lower_hex }}ff)",
    base03 = "rgba({{ base03 | lower_hex }}ff)",
    base04 = "rgba({{ base04 | lower_hex }}ff)",
    base05 = "rgba({{ base05 | lower_hex }}ff)",
    base06 = "rgba({{ base06 | lower_hex }}ff)",
    base07 = "rgba({{ base07 | lower_hex }}ff)",
    base08 = "rgba({{ base08 | lower_hex }}ff)",
    base09 = "rgba({{ base09 | lower_hex }}ff)",
    base0A = "rgba({{ base0A | lower_hex }}ff)",
    base0B = "rgba({{ base0B | lower_hex }}ff)",
    base0C = "rgba({{ base0C | lower_hex }}ff)",
    base0D = "rgba({{ base0D | lower_hex }}ff)",
    base0E = "rgba({{ base0E | lower_hex }}ff)",
    base0F = "rgba({{ base0F | lower_hex }}ff)",

    -- Pre-composed alphas. Hyprland cannot concatenate an alpha onto a colour, so
    -- anything non-opaque has to be written out whole.
    shadow      = "rgba({{ shadow | lower_hex }}99)",
    surface     = "rgba({{ base00 | lower_hex }}cc)",
    ov_backdrop = "rgba({{ base00 | lower_hex }}d9)",
    ov_accent   = "rgba({{ base0D | lower_hex }}ff)",
    ov_accent2  = "rgba({{ base0C | lower_hex }}ff)",
}
