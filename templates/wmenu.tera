# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# Generated by coat. wmenu has NO config file at all -- it takes its colours as
# command-line flags -- so this is a shell fragment sourced by ~/.local/bin/menu
# and menu-run, which are what the compositor actually binds.
#
# Flag meanings, in wmenu(1)'s order:
#   -N normal background   -n normal foreground
#   -M prompt background   -m prompt foreground
#   -S selection background -s selection foreground

WMENU_COLORS="-N '#{{ base00 }}' -n '#{{ base05 }}' -M '#{{ base00 }}' -m '#{{ base0D }}' -S '#{{ base0D }}' -s '#{{ base00 }}'"
{% if font_monospace %}WMENU_FONT="{{ font_monospace }} {{ font_size_popups }}"
{% endif %}
