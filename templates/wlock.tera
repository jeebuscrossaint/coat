/* coat theme: {{ scheme_name }}
 * {{ scheme_author }}
{% if scheme_variant %} * variant: {{ scheme_variant }}
{% endif %} *
 * Generated by coat -- do not edit. wlock is configured at compile time, so
 * this header is included by config.def.h and the tree is rebuilt on apply.
 *
 * These are whole-screen fills, not text on a background, so the base16 slots
 * that are unreliable for chrome are fine here. Deliberately dark: INPUT and
 * INPUT_ALT alternate on every keystroke, and flashing a near-white screen
 * while typing a password at night is unpleasant.
 *
 * wlock stores colour components as 32-bit per channel and scales them from
 * 8-bit hex the same way wlock.c does, hence COAT_C8.
 */

#define COAT_THEMED 1

#define COAT_C8(x) ((x) * (0xffffffffu / 0xffu))
#define COAT_RGB(hex) \
	COAT_C8(((hex) >> 16) & 0xff), \
	COAT_C8(((hex) >>  8) & 0xff), \
	COAT_C8(((hex) >>  0) & 0xff)

#define COAT_INIT      COAT_RGB(0x{{ base00 | lower }})  /* idle */
#define COAT_INPUT     COAT_RGB(0x{{ base03 | lower }})  /* typing */
#define COAT_INPUT_ALT COAT_RGB(0x{{ base0D | lower }})  /* typing, alternate */
#define COAT_FAILED    COAT_RGB(0x{{ base08 | lower }})  /* wrong password */
