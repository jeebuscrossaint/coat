// coat — {{ scheme_name }} — fastfetch
//
// fastfetch takes hex directly and expands it to a truecolor SGR itself.
// Verified: --color-keys "#ff0000" emits 38;2;255;0;0.
//
// It also strips ALL colour when stdout is not a TTY, so a piped `fastfetch`
// looking monochrome is not this file being wrong.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // The logo is the current wallpaper, drawn with kitty's graphics protocol.
  // kitty-direct hands the terminal a PATH instead of transmitting the pixels,
  // so it costs nothing to render but only works in a terminal that reads the
  // file itself (kitty, ghostty) -- not over SSH.
  //
  // fastfetch cannot run a command to find the wallpaper, so the path has to be
  // stable: ~/.local/bin/awww maintains this symlink on every wallpaper change.
  // If it is missing or dangling, fastfetch quietly falls back to the built-in
  // distro logo, which is why the colours below are still worth setting.
  "logo": {
    "type": "kitty-direct",
    "source": "~/.cache/current-wallpaper",
    "width": 32,
    "height": 16,
    "preserveAspectRatio": true,
    "padding": { "top": 1, "right": 3 },
    "color": {
      "1": "#{{ base0D | lower_hex }}",
      "2": "#{{ base0E | lower_hex }}"
    }
  },
  "display": {
    "color": {
      "keys": "#{{ base0D | lower_hex }}",
      "title": "#{{ base0E | lower_hex }}",
      "output": "#{{ base05 | lower_hex }}",
      "separator": "#{{ base03 | lower_hex }}"
    },
    "separator": " → ",
    "key": { "width": 12 }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "pkgs" },
    { "type": "shell", "key": "shell" },
    { "type": "wm", "key": "wm" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu", "key": "cpu" },
    { "type": "gpu", "key": "gpu" },
    { "type": "memory", "key": "mem" },
    { "type": "swap", "key": "swap" },
    { "type": "disk", "key": "disk" },
    { "type": "battery", "key": "battery" },
    { "type": "custom", "format": "coat: {{ scheme_name }}" },
    "break",
    "colors"
  ]
}
