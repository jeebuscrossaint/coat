-- coat theme: {{ scheme_name }}
-- {{ scheme_author }}
{% if scheme_variant %}-- variant: {{ scheme_variant }}{% endif %}
--
-- Generated by coat. Do NOT edit by hand — run `coat apply hyprland` to regenerate.
-- hyprland.lua loads it with require("coat-colors").
--
-- Colours are rgba() strings rather than 0xAARRGGBB integers: Hyprland's Lua
-- bindings accept the string form everywhere, gradient tables included.

return {
{% if font_monospace %}    font      = "{{ font_monospace }}",
{% endif %}{% if font_sansserif %}    font_sans = "{{ font_sansserif }}",
{% endif %}    font_size = {{ font_size_desktop }},

    base00 = "rgba({{ base00 | lower_hex }}ff)",
    base01 = "rgba({{ base01 | lower_hex }}ff)",
    base02 = "rgba({{ base02 | lower_hex }}ff)",
    base03 = "rgba({{ base03 | lower_hex }}ff)",
    base04 = "rgba({{ base04 | lower_hex }}ff)",
    base05 = "rgba({{ base05 | lower_hex }}ff)",
    base06 = "rgba({{ base06 | lower_hex }}ff)",
    base07 = "rgba({{ base07 | lower_hex }}ff)",
    base08 = "rgba({{ base08 | lower_hex }}ff)",
    base09 = "rgba({{ base09 | lower_hex }}ff)",
    base0A = "rgba({{ base0A | lower_hex }}ff)",
    base0B = "rgba({{ base0B | lower_hex }}ff)",
    base0C = "rgba({{ base0C | lower_hex }}ff)",
    base0D = "rgba({{ base0D | lower_hex }}ff)",
    base0E = "rgba({{ base0E | lower_hex }}ff)",
    base0F = "rgba({{ base0F | lower_hex }}ff)",

    -- Hyprland cannot concatenate an alpha onto a colour, so anything
    -- non-opaque is written out whole. `shadow` is the darkest colour on the
    -- scheme's neutral ramp, so it stays a shadow on light schemes too.
    shadow  = "rgba({{ shadow | lower_hex }}99)",
    surface = "rgba({{ base00 | lower_hex }}cc)",
}
