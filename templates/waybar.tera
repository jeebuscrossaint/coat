/* coat theme: {{ scheme_name }}
 * {{ scheme_author }}
{% if scheme_variant %} * variant: {{ scheme_variant }}{% endif %}
 *
 * Generated by coat, pulled into ~/.config/waybar/style.css via
 * `@import "coat-colors.css";`. Colours and font only -- geometry, padding and
 * module layout stay in style.css, and anything there AFTER the @import wins.
 *
 * Only base05 and base03 on base00 are used for text. base01/02/04/06 are not
 * trustworthy for chrome: plenty of base16 schemes leave them at contrast ratios
 * that are unreadable, so they are avoided entirely.
 */

* {
{% if font_monospace %}  font-family: "{{ font_monospace }}";
  font-size: {{ font_size_desktop }}pt;
{% endif %}
}

window#waybar {
  background: #{{ base00 }};
  color: #{{ base05 }};
}

/* mango's tag colours are pango markup emitted by ~/.local/bin/mango-tags, not
 * CSS -- waybar cannot style parts of a custom module's text. This only sets the
 * module's own background and its fallback colour. */
#custom-mangotags {
  background: #{{ base00 }};
  color: #{{ base03 }};
}

#taskbar button {
  background: #{{ base00 }};
  color: #{{ base0D }};
}

#taskbar button.active {
  color: #{{ base0D }};
}

#mpris,
#network,
#disk,
#cpu,
#memory,
#temperature,
#custom-fan,
#backlight,
#wireplumber,
#battery,
#custom-uptime {
  background: #{{ base00 }};
  color: #{{ base05 }};
}

#clock {
  background: #{{ base00 }};
  color: #{{ base0D }};
}

/* States. This is what a single slstatus text blob could not do. */
#mpris.paused,
#mpris.stopped,
#wireplumber.muted {
  color: #{{ base03 }};
}

#battery.warning {
  color: #{{ base0A }};
}

#battery.critical,
#temperature.critical,
#network.disconnected {
  color: #{{ base08 }};
}

#battery.charging,
#battery.full {
  color: #{{ base0B }};
}

#mode {
  color: #{{ base0A }};
}
