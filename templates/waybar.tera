/* coat theme: {{ scheme_name }}
 * {{ scheme_author }}
{% if scheme_variant %} * variant: {{ scheme_variant }}{% endif %}
 *
 * Generated by coat, pulled into ~/.config/waybar/style.css via
 * `@import "coat-colors.css";`. Colours and font only -- geometry, padding and
 * module layout stay in style.css, and anything there AFTER the @import wins.
 *
 * Only base05 and base03 on base00 are used for text. base01/02/04/06 are not
 * trustworthy for chrome: plenty of base16 schemes leave them at contrast ratios
 * that are unreadable, so they are avoided entirely.
 */

* {
{% if font_monospace %}  font-family: "{{ font_monospace }}";
  font-size: {{ font_size_desktop }}pt;
{% endif %}
}

/* Slightly translucent, not solid. Under wayfire this is what the blur shows through
 * -- an opaque bar would frost nothing, because blur only affects what is BEHIND a
 * surface. Under mango and labwc, which have no blur, this reads as a subtle tint of
 * the wallpaper and is still fully legible because base05 on base00 is the guaranteed
 * pair.
 *
 * rgba() and NOT #rrggbbaa: GTK's CSS parser has no 8-digit hex form and rejects the
 * whole declaration with "Junk at end of value", which takes the entire stylesheet
 * down with it -- the bar came up completely unstyled. The r/g/b filters exist for
 * exactly this. */
/* The bar WINDOW is transparent: the visible slabs are the module groups below, so the
 * bar reads as pills floating over the wallpaper instead of one bar welded to the screen
 * edge. Geometry (radius, margins, padding) is in style.css. */
/* ONE background, on the bar itself. No per-module and no per-section backgrounds --
 * those boxes behind each field are the "section highlighting" that had to go. */
window#waybar {
  background: #{{ base00 }};
  color: #{{ base05 }};
}

/* No background on the module groups and none on the clock. The bar is text over the
 * wallpaper; the group slabs rendered as visible blocks at the bar's ends. The clock
 * keeps the accent as TEXT colour instead of a filled pill. */
#clock {
  color: #{{ base0D }};
}

/* mango's tag colours are pango markup emitted by ~/.local/bin/mango-tags, not
 * CSS -- waybar cannot style parts of a custom module's text. This only sets the
 * fallback colour. No background: the bar is text over the wallpaper, and an opaque
 * base00 behind each module is exactly the per-section highlighting that had to go. */
#custom-mangotags {
  color: #{{ base03 }};
}

/* #workspaces is emitted by waybar's ext-workspace-v1 module and by its native
 * hyprland/workspaces. mango speaks neither -- its tag row is a custom module
 * coloured by inline pango -- so these rules do nothing in a mango session and
 * everything in a Hyprland one:
 *
 *   inactive  base03  dim, present but receding
 *   active    base0D  the accent
 *   urgent    base08  the red
 *
 * base03 and base05 on base00 are the only text pairs trusted here (see the header
 * note); base01/02/04/06 are skipped deliberately.
 *
 * `background: transparent` on the button, not base00: GTK paints its own button
 * background over the bar's, and a solid base00 would defeat any future bar
 * transparency. Geometry for these lives in style.css. */
#workspaces button {
  background: transparent;
  color: #{{ base03 }};
}

#workspaces button.active {
  color: #{{ base0D }};
}

#workspaces button.urgent {
  color: #{{ base08 }};
}

/* .hidden is a workspace that exists but is not on any output. Same treatment as
 * inactive rather than invisible -- a number vanishing from the row and a number
 * going dim look very different when you are trying to find a window. */
#workspaces button.hidden {
  color: #{{ base03 }};
}

/* #window is a focused-title module (hyprland/window, sway/window). The mango
 * equivalent is custom/mangotitle, which cannot be reached from CSS -- waybar
 * cannot style characters inside a custom module -- so ~/.local/bin/mango-title
 * reads this same accent out of coat's mango fragment instead. Both end up
 * base0D; only the route differs. */
#window {
  color: #{{ base0D }};
}

#taskbar button {
  color: #{{ base0D }};
}

#taskbar button.active {
  color: #{{ base0D }};
}


#mpris,
#network,
#disk,
#cpu,
#memory,
#temperature,
#custom-fan,
#backlight,
#wireplumber,
#battery,
#custom-uptime {
  color: #{{ base05 }};
}

#clock {
  color: #{{ base0D }};
}

/* States. This is what a single slstatus text blob could not do. */
#mpris.paused,
#mpris.stopped,
#wireplumber.muted {
  color: #{{ base03 }};
}

#battery.warning {
  color: #{{ base0A }};
}

#battery.critical,
#temperature.critical,
#network.disconnected {
  color: #{{ base08 }};
}

#battery.charging,
#battery.full {
  color: #{{ base0B }};
}

#mode {
  color: #{{ base0A }};
}
