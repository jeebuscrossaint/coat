# coat theme: {{ scheme_name }}
# {{ scheme_author }}
#
# Generated by coat. Do NOT edit by hand -- run `coat apply micro` to regenerate.
# Selected with  "colorscheme": "coat"  in ~/.config/micro/settings.json.
#
# micro's syntax is  color-link <group> "<fg>,<bg>"  where either half may be
# omitted. Two groups are special: `cursor-line` and `color-column` take a SINGLE
# colour which micro applies as the BACKGROUND, which is why they look like a
# foreground here and are not.
#
# Slot choices mirror templates/neovim.tera so both editors render the same
# scheme the same way -- identifier/base0D, keywords/base0E, strings/base0B.

# ── Editor surface ───────────────────────────────────────────────────────────
color-link default              "#{{ base05 }},#{{ base00 }}"
color-link cursor-line          "#{{ base01 }}"
color-link color-column         "#{{ base01 }}"
color-link line-number          "#{{ base03 }},#{{ base00 }}"
color-link current-line-number  "#{{ base0A }},#{{ base01 }}"
color-link line-number.scrollbar "#{{ base03 }},#{{ base00 }}"
color-link current-line-number.scroller "#{{ base0A }},#{{ base00 }}"
color-link scrollbar            "#{{ base03 }}"
color-link divider              "#{{ base03 }},#{{ base00 }}"
color-link indent-char          "#{{ base03 }},#{{ base00 }}"
color-link space                "#{{ base03 }}"

# Chrome. base04 is the spec's "dark foreground" and is the one slot here that
# some published schemes fill with a saturated colour instead -- it is used only
# for statusline TEXT, never as a background, so a bad scheme costs legibility on
# one line rather than the whole frame.
color-link statusline           "#{{ base04 }},#{{ base01 }}"
color-link tabbar               "#{{ base03 }},#{{ base01 }}"

# ── Syntax ───────────────────────────────────────────────────────────────────
color-link comment              "#{{ base03 }}"
color-link identifier           "#{{ base0D }}"
color-link identifier.class     "#{{ base0A }}"
color-link identifier.var       "#{{ base08 }}"
color-link identifier.macro     "#{{ base0F }}"
color-link constant             "#{{ base09 }}"
color-link constant.number      "#{{ base09 }}"
color-link constant.bool        "#{{ base09 }}"
color-link constant.bool.true   "#{{ base0B }}"
color-link constant.bool.false  "#{{ base08 }}"
color-link constant.string      "#{{ base0B }}"
color-link constant.string.char "#{{ base0B }}"
color-link constant.string.url  "underline #{{ base0C }}"
color-link constant.specialChar "#{{ base0C }}"
color-link statement            "#{{ base0E }}"
color-link symbol               "#{{ base05 }}"
color-link symbol.brackets      "#{{ base05 }}"
color-link symbol.operator      "#{{ base05 }}"
color-link symbol.tag           "#{{ base08 }}"
color-link symbol.tag.extended  "#{{ base08 }}"
color-link preproc              "#{{ base0A }}"
color-link preproc.shebang      "#{{ base0F }}"
color-link type                 "#{{ base0A }}"
color-link type.keyword         "#{{ base0E }}"
color-link type.extended        "#{{ base0A }}"
color-link special              "#{{ base0C }}"
color-link ignore               "#{{ base05 }}"
color-link underlined           "underline #{{ base0D }}"
color-link underlined.url       "underline #{{ base0C }}"
color-link todo                 "bold #{{ base0A }}"
color-link error                "#{{ base00 }},#{{ base08 }}"

# ── Signals ──────────────────────────────────────────────────────────────────
color-link hlsearch             "#{{ base00 }},#{{ base0A }}"
color-link match-brace          "#{{ base00 }},#{{ base0C }}"
color-link gutter-error         "#{{ base08 }}"
color-link gutter-warning       "#{{ base0A }}"
color-link diff-added           "#{{ base0B }}"
color-link diff-modified        "#{{ base0E }}"
color-link diff-deleted         "#{{ base08 }}"
color-link tab-error            "#{{ base00 }},#{{ base08 }}"
color-link trailingws           "#{{ base00 }},#{{ base08 }}"
