// coat theme: {{ scheme_name }}
// {{ scheme_author }}
{% if scheme_variant %}// variant: {{ scheme_variant }}
{% endif %}//
// Generated by coat. Do NOT edit by hand — run `coat apply niri` to regenerate.
// config.kdl pulls it in with `include optional=true "~/.config/niri/coat.kdl"`;
// niri watches included files, so a scheme change recolours a running session.
//
// Colours only. Sections merge across includes, so widths, gaps and on/off
// stay in config.kdl, and anything config.kdl sets after the include wins.

layout {
    background-color "#{{ base00 | lower_hex }}"

    // base05 focused, base03 not: the only pair legible on base00 across schemes.
    focus-ring {
        active-color "#{{ base05 | lower_hex }}"
        inactive-color "#{{ base03 | lower_hex }}"
        urgent-color "#{{ base08 | lower_hex }}"
    }

    border {
        active-color "#{{ base05 | lower_hex }}"
        inactive-color "#{{ base03 | lower_hex }}"
        urgent-color "#{{ base08 | lower_hex }}"
    }

    shadow {
        color "#{{ shadow | lower_hex }}70"
        inactive-color "#{{ shadow | lower_hex }}50"
    }

    tab-indicator {
        active-color "#{{ base05 | lower_hex }}"
        inactive-color "#{{ base03 | lower_hex }}"
        urgent-color "#{{ base08 | lower_hex }}"
    }

    insert-hint {
        color "#{{ base0D | lower_hex }}80"
    }
}

overview {
    backdrop-color "#{{ base00 | lower_hex }}"

    workspace-shadow {
        color "#{{ shadow | lower_hex }}50"
    }
}

recent-windows {
    highlight {
        active-color "#{{ base05 | lower_hex }}ff"
        urgent-color "#{{ base08 | lower_hex }}ff"
    }
}

// Whatever window is being screen-shared is outlined in base08.
window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#{{ base08 | lower_hex }}"
        inactive-color "#{{ base08 | lower_hex }}"
    }

    border {
        active-color "#{{ base08 | lower_hex }}"
        inactive-color "#{{ base08 | lower_hex }}"
    }
}
