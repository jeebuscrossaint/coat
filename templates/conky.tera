-- coat theme: {{ scheme_name }}
-- {{ scheme_author }}
{% if scheme_variant %}-- variant: {{ scheme_variant }}{% endif %}
--
-- Generated by coat, for a Lua conky config:
--
--     local c = dofile(os.getenv("HOME") .. "/.config/conky/coat-colors.lua")
--     conky.config = { default_color = c.base05, color1 = c.base0D }
--
-- A separate file rather than patched keys, because conky.conf is Lua rather than
-- ini and there is nothing to address a key by. dofile also means conky's own
-- auto-reload does not see the change -- it watches conky.conf, not what that file
-- loads -- so coat signals the process itself after writing.
--
-- Colours are BARE hex with no leading '#'. That is conky's spelling everywhere a
-- colour is taken, in both `default_color` and the ${color RRGGBB} inline form,
-- and a '#' is rejected.

return {
{% if font_monospace %}    font      = "{{ font_monospace }}",
{% endif %}    font_size = {{ font_size_desktop }},

    base00 = "{{ base00 }}",
    base01 = "{{ base01 }}",
    base02 = "{{ base02 }}",
    base03 = "{{ base03 }}",
    base04 = "{{ base04 }}",
    base05 = "{{ base05 }}",
    base06 = "{{ base06 }}",
    base07 = "{{ base07 }}",
    base08 = "{{ base08 }}",
    base09 = "{{ base09 }}",
    base0A = "{{ base0A }}",
    base0B = "{{ base0B }}",
    base0C = "{{ base0C }}",
    base0D = "{{ base0D }}",
    base0E = "{{ base0E }}",
    base0F = "{{ base0F }}",
}
