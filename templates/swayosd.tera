/* coat theme: {{ scheme_name }}
 * {{ scheme_author }}
{% if scheme_variant %} * variant: {{ scheme_variant }}
{% endif %} *
 * Generated by coat. Do NOT edit by hand — run `coat apply swayosd`.
 *
 * swayosd-server reads ~/.config/swayosd/style.css at startup; coat restarts
 * the server so a theme switch takes effect immediately.
 *
 * Selectors come from SwayOSD's own data/style/style.scss. They are written
 * out flat here on purpose: GTK's CSS parser has no nested-rule support, so
 * upstream's SCSS nesting cannot be used verbatim.
 */

window#osd {
  border-radius: 16px;
  border: 1px solid rgba({{ base0D | r }}, {{ base0D | g }}, {{ base0D | b }}, 1.0);
  /* Surface (base01) at coat's popups opacity — lower that setting to make
     the OSD translucent. */
  background-color: rgba({{ base01 | r }}, {{ base01 | g }}, {{ base01 | b }}, {{ opacity_popups }});
}

window#osd #container {
  margin: 16px;
}

/* Icon and percentage label — foreground (base05). */
window#osd image,
window#osd label {
  color: rgba({{ base05 | r }}, {{ base05 | g }}, {{ base05 | b }}, 1.0);
{% if font_monospace %}  font-family: "{{ font_monospace }}";
  font-size: {{ font_size_popups }}pt;
{% endif %}}

window#osd progressbar:disabled,
window#osd image:disabled {
  opacity: 0.5;
}

window#osd progressbar,
window#osd segmentedprogress {
  min-height: 6px;
  border-radius: 999px;
  background: transparent;
  border: none;
}

/* Unfilled track — muted (base03). */
window#osd trough,
window#osd segment {
  min-height: inherit;
  border-radius: inherit;
  border: none;
  background-color: rgba({{ base03 | r }}, {{ base03 | g }}, {{ base03 | b }}, 1.0);
}

/* Filled progress — accent (base0D). */
window#osd progress,
window#osd segment.active {
  min-height: inherit;
  border-radius: inherit;
  border: none;
  background-color: rgba({{ base0D | r }}, {{ base0D | g }}, {{ base0D | b }}, 1.0);
}

window#osd segment {
  margin-left: 8px;
}

window#osd segment:first-child {
  margin-left: 0;
}
