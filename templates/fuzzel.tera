# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# Generated by coat, pulled in from ~/.config/fuzzel/fuzzel.ini via
# `include=~/.config/fuzzel/coat-theme.ini`. Font, font size and colours only —
# terminal, layer, width, lines, padding, prompt and icon settings are yours.
#
# The font key has to sit above [colors]: an include carries its own section
# scope, and keys before the first header land in fuzzel's default `main`.

{% if font_monospace %}font={{ font_monospace }}:size={{ font_size_popups }}
{% endif %}
[colors]
background={{ base00 }}{{ opacity_popups_hex }}
text={{ base05 }}ff
match={{ base0D }}ff
selection={{ base02 }}ff
selection-text={{ base05 }}ff
selection-match={{ base0D }}ff
border={{ base0D }}ff
