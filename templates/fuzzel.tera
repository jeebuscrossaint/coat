# coat fuzzel theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# Generated by coat. Pulled into ~/.config/fuzzel/fuzzel.ini by an `include=` line
# coat adds on first apply. Colours, font and popup opacity only -- width, lines,
# padding, match-mode and the keybindings are yours and coat never opens that file
# except to add the include.
#
# fuzzel DOES support include, contrary to what this module assumed for a long
# time. It patched fuzzel.ini's keys in place instead, which meant the colours and
# the font were hardcoded into the one file the user also hand-edits -- the only
# module here that worked that way.
#
# include is resolved where the line appears, so anything set AFTER it in
# fuzzel.ini overrides this. Keep the include at the top and leave font/colours
# out of fuzzel.ini.
#
# COLOURS HAVE NO LEADING '#', and that is unique to fuzzel. The format is
# rrggbbaa -- eight hex digits, alpha included, bare. `#1a1a1aff` is rejected.

font={{ font_monospace }}:size={{ font_size_popups }}

[colors]
# base05 text on base00, base03 for anything secondary, base0D for the accent.
# Nothing from base01/02/04/06 -- plenty of schemes leave those at unreadable
# contrast.
#
# The background alpha is coat's popups opacity, so the launcher frosts with the
# rest of the setup instead of carrying a hardcoded value.
background={{ base00 }}{{ opacity_popups_hex }}
text={{ base05 }}ff
match={{ base0D }}ff
selection={{ base0D }}ff
selection-text={{ base00 }}ff
selection-match={{ base00 }}ff
prompt={{ base03 }}ff
placeholder={{ base03 }}ff
input={{ base05 }}ff
message={{ base03 }}ff
# `counter` IS valid on 1.14.1 -- an earlier note here said it was not. It colours
# the n/total readout, which renders only with `fuzzel --counter`; that flag is
# CLI-only and is rejected as an ini key.
counter={{ base03 }}ff
# The border COLOUR lives in [colors]. [border] itself takes only width, radius
# and selection-radius -- all geometry, all the user's -- and `[border] color` is
# rejected outright.
border={{ base0D }}ff
