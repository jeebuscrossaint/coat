# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# Generated by coat. Colours, font and the popups opacity only.
#
# swaylock has no include directive, so this is a standalone config passed with
# `-C`; coat does NOT touch ~/.config/swaylock/config. Behaviour — indicator
# size, clock, effects, show-failed-attempts — goes on the command line in your
# launcher, where a CLI flag beats anything in here:
#
#     swaylock -C ~/.config/swaylock/coat-theme.conf --clock --indicator-radius=110
#
# Note that effect/clock flags need the swaylock-effects fork; plain swaylock
# errors out on them, which is exactly why they are not baked in here.

# Background
color={{ base00 }}{{ opacity_popups_hex }}
{% if font_monospace %}font={{ font_monospace }}
{% endif %}
# Ring colors
ring-color={{ base03 }}
ring-clear-color={{ base0C }}
ring-caps-lock-color={{ base09 }}
ring-ver-color={{ base0D }}
ring-wrong-color={{ base08 }}

# Inside colors
inside-color={{ base00 }}
inside-clear-color={{ base00 }}
inside-caps-lock-color={{ base00 }}
inside-ver-color={{ base00 }}
inside-wrong-color={{ base00 }}

# Line colors (separator)
line-color={{ base01 }}
line-clear-color={{ base01 }}
line-caps-lock-color={{ base01 }}
line-ver-color={{ base01 }}
line-wrong-color={{ base01 }}

# Text colors
text-color={{ base05 }}
text-clear-color={{ base0C }}
text-caps-lock-color={{ base09 }}
text-ver-color={{ base0D }}
text-wrong-color={{ base08 }}

# Key highlight colors
key-hl-color={{ base0B }}
bs-hl-color={{ base08 }}
caps-lock-key-hl-color={{ base09 }}
caps-lock-bs-hl-color={{ base08 }}

# Separator color
separator-color={{ base02 }}

# Layout indicator colors
layout-bg-color={{ base01 }}
layout-border-color={{ base03 }}
layout-text-color={{ base05 }}
