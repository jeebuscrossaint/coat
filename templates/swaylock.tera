# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# Generated by coat. swaylock has no include mechanism, so coat owns this whole
# file; the indicator geometry lives in coat's templates/swaylock.tera.
#
# swaylock reads this at every invocation, so there is nothing to reload -- the
# next lock picks up a new scheme by itself.
#
# Colours are RRGGBB[AA] with no leading '#'.

# No image: the wallpaper is not visible under a lock surface anyway, and reading
# a multi-megabyte JPEG on every lock is wasted IO.
color={{ base00 }}

indicator
indicator-radius=90
indicator-thickness=6
indicator-caps-lock

# Ring: accent while idle, base05 while verifying, base08 when wrong, base0A when
# cleared. Only these slots are trusted -- base01/02/04/06 sit at contrast ratios
# in some schemes where the ring vanishes against base00 entirely.
ring-color={{ base0D }}
ring-clear-color={{ base0A }}
ring-ver-color={{ base05 }}
ring-wrong-color={{ base08 }}

inside-color={{ base00 }}00
inside-clear-color={{ base00 }}00
inside-ver-color={{ base00 }}00
inside-wrong-color={{ base00 }}00

key-hl-color={{ base05 }}
bs-hl-color={{ base08 }}
separator-color=00000000

text-color={{ base05 }}
text-clear-color={{ base05 }}
text-ver-color={{ base05 }}
text-wrong-color={{ base08 }}
{% if font_monospace %}font={{ font_monospace }}
font-size=14
{% endif %}

# Caps lock surfaced deliberately: mango has no release-triggered keybinding, so
# the caps-lock OSD is unbound, and a lock screen is exactly where a silent caps
# lock costs three failed attempts.
text-caps-lock-color={{ base0A }}
ring-caps-lock-color={{ base0A }}
inside-caps-lock-color={{ base00 }}00
caps-lock-key-hl-color={{ base0A }}
caps-lock-bs-hl-color={{ base08 }}

# Fail closed: without this a crashed swaylock leaves the session unlocked.
ignore-empty-password
show-failed-attempts
