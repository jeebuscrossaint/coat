# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# Generated by coat — a FRAGMENT beside ~/.config/swaylock/config, never that file.
#
# swaylock reads exactly one config and has no include mechanism, so coat used to
# patch these keys into your config in place. That file is normally a dotfiles
# symlink, which made every `coat set` a diff in the repo.
#
# The way out is the command line rather than an include: every swaylock config
# key is also a long flag, and swaylock parses argv AFTER the config file so that
# flags win. The caller turns this file into flags:
#
#     swaylock $(grep -v '^#' ~/.config/swaylock/coat-theme.conf | sed 's/^/--/')
#
# So geometry, behaviour and the indicator are yours in swaylock/config, and only
# what is below follows the scheme. Nothing here is read unless the caller passes
# it: swaylock does not find this file on its own.
#
# swaylock colours are bare rrggbb (or rrggbbaa), no leading '#'.

color={{ base00 }}
ring-color={{ base0D }}
ring-clear-color={{ base0A }}
ring-ver-color={{ base05 }}
ring-wrong-color={{ base08 }}
inside-color={{ base01 }}e6
inside-clear-color={{ base0A }}33
inside-ver-color={{ base0D }}33
inside-wrong-color={{ base08 }}33
key-hl-color={{ base05 }}
bs-hl-color={{ base08 }}
line-color={{ base00 }}
line-clear-color={{ base00 }}
line-ver-color={{ base00 }}
line-wrong-color={{ base00 }}
line-caps-lock-color={{ base00 }}
separator-color=00000000
text-color={{ base05 }}
text-clear-color={{ base05 }}
text-ver-color={{ base05 }}
text-wrong-color={{ base08 }}
text-caps-lock-color={{ base0A }}
ring-caps-lock-color={{ base0A }}
inside-caps-lock-color={{ base0A }}33
caps-lock-key-hl-color={{ base0A }}
caps-lock-bs-hl-color={{ base08 }}
{% if font_monospace %}font={{ font_monospace }}
{% endif %}
