# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# An edit list, not a config file:
#
#     <section>  <key>  <value>
#
# swaylock's config has no sections, so every edit is addressed to `_`, coat's name
# for a file's top-level region. coat patches these keys into
# ~/.config/swaylock/config in place and leaves every other line alone.
#
# This file used to be coat's outright, which put indicator-radius, font-size and
# flags like show-failed-attempts under coat's control -- none of them colours, and
# all of them silently restored to coat's opinion on every theme change.
#
# swaylock colours are bare rrggbb (or rrggbbaa), no leading '#'.

_  color                     {{ base00 }}
_  ring-color                {{ base0D }}
_  ring-clear-color          {{ base0A }}
_  ring-ver-color            {{ base05 }}
_  ring-wrong-color          {{ base08 }}
_  inside-color              {{ base00 }}00
_  inside-clear-color        {{ base00 }}00
_  inside-ver-color          {{ base00 }}00
_  inside-wrong-color        {{ base00 }}00
_  key-hl-color              {{ base05 }}
_  bs-hl-color               {{ base08 }}
_  separator-color           00000000
_  text-color                {{ base05 }}
_  text-clear-color          {{ base05 }}
_  text-ver-color            {{ base05 }}
_  text-wrong-color          {{ base08 }}
_  text-caps-lock-color      {{ base0A }}
_  ring-caps-lock-color      {{ base0A }}
_  inside-caps-lock-color    {{ base00 }}00
_  caps-lock-key-hl-color    {{ base0A }}
_  caps-lock-bs-hl-color     {{ base08 }}
{% if font_monospace %}_  font                      {{ font_monospace }}
{% endif %}
