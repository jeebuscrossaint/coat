/* coat theme: {{ scheme_name }} — {{ scheme_author }}
{% if scheme_variant %} * variant: {{ scheme_variant }}
{% endif %} *
 * Generated by coat, pulled in from ~/.config/gtklock/style.css via
 * @import url("coat-theme.css"). Colours, font and the popups opacity only —
 * layout, time/date format and behaviour live in gtklock's config.ini.
 *
 * Selector notes, because gtklock's widget ids are NOT usable here: GTK3 does
 * not turn a GtkBuilder id into a CSS name, and gtklock calls
 * gtk_widget_set_name() on the window ONLY. So #clock-label, #input-field and
 * the rest silently match nothing — style by widget type instead. The window
 * does carry .focused (monitor with the form) and .hidden (idle).
 */

@define-color base00 #{{ base00 }};
@define-color base01 #{{ base01 }};
@define-color base02 #{{ base02 }};
@define-color base03 #{{ base03 }};
@define-color base04 #{{ base04 }};
@define-color base05 #{{ base05 }};
@define-color base06 #{{ base06 }};
@define-color base07 #{{ base07 }};
@define-color base08 #{{ base08 }};
@define-color base09 #{{ base09 }};
@define-color base0A #{{ base0A }};
@define-color base0B #{{ base0B }};
@define-color base0C #{{ base0C }};
@define-color base0D #{{ base0D }};
@define-color base0E #{{ base0E }};
@define-color base0F #{{ base0F }};

window {
    background-color: rgba({{ base00 | r }}, {{ base00 | g }}, {{ base00 | b }}, {{ opacity_popups }});
    color: @base05;
{% if font_monospace %}    font-family: "{{ font_monospace }}";
    font-size: {{ font_size_desktop }}pt;
{% endif %}}

label {
    color: @base05;
}

/* Password entry. The caret and selection need setting explicitly — they do not
 * inherit from `color`. */
entry {
    background-color: @base01;
    color: @base05;
    border: 1px solid @base03;
    caret-color: @base05;
}

entry:focus {
    border-color: @base0D;
}

entry selection {
    background-color: @base02;
    color: @base05;
}

button {
    background-image: none;
    background-color: @base01;
    color: @base05;
    border: 1px solid @base03;
}

button:hover {
    background-color: @base02;
}

/* The unlock button carries .suggested-action from gtklock's .ui. */
button.suggested-action {
    background-color: @base0D;
    color: @base00;
    border-color: @base0D;
}

button.suggested-action:hover {
    background-color: @base0C;
}
