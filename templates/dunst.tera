# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# Generated by coat — a dunst DROP-IN, not your dunstrc. Colours, font and the
# popups opacity only; geometry, timeouts, icons, mouse actions, format and the
# dmenu/browser commands are yours and live in ~/.config/dunst/dunstrc.
#
# dunst applies drop-ins after the base dunstrc, in lexical order, last one
# winning — so this overrides colours set in your dunstrc, and you can override
# coat in turn with a later-sorting drop-in (e.g. 99-mine.conf).

[global]
{% if font_monospace %}    font = {{ font_monospace }} {{ font_size_popups }}
{% endif %}    frame_color = "#{{ base02 }}"
    separator_color = frame
    highlight = "#{{ base0D }}, #{{ base0C }}, #{{ base0E }}"

[urgency_low]
    background = "#{{ base00 }}{{ opacity_popups_hex }}"
    foreground = "#{{ base04 }}"
    frame_color = "#{{ base03 }}"

[urgency_normal]
    background = "#{{ base00 }}{{ opacity_popups_hex }}"
    foreground = "#{{ base07 }}"
    frame_color = "#{{ base02 }}"

[urgency_critical]
    background = "#{{ base00 }}{{ opacity_popups_hex }}"
    foreground = "#{{ base08 }}"
    frame_color = "#{{ base08 }}"
