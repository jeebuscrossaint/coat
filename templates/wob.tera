# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# Generated by coat. wob has no include mechanism, so coat owns this whole file:
# geometry as well as colour. If you want different geometry, change it in
# coat's templates/wob.tera rather than here -- edits to this file are lost on
# the next `coat set`.
#
# Colours are RRGGBBAA with NO leading '#'. A '#' is a parse error, not a
# fallback to a default.

timeout = 900
max = 100
width = 320
height = 36
border_offset = 0
border_size = 1
bar_padding = 3

# Bottom centre, clear of the bar. waybar is 22px at the bottom, so anything
# under about 40 here puts the OSD on top of the status line.
anchor = bottom center
margin = 60

background_color = {{ base00 }}E6
border_color = {{ base03 }}FF
bar_color = {{ base0D }}FF

# Volume can exceed 100% (the wpctl ceiling here is 150%), so overflow has to be
# visible rather than clamped: past max the bar wraps and turns base08, which
# reads as "boosting" instead of "stuck full".
overflow_mode = wrap
overflow_bar_color = {{ base08 }}FF
overflow_background_color = {{ base00 }}E6
overflow_border_color = {{ base08 }}FF

orientation = horizontal

# Selected by writing "<value> muted" to the FIFO, which ~/.local/bin/osd does.
# The level stays real so you can see what you silenced; the colour says it is
# silenced.
[style.muted]
bar_color = {{ base03 }}FF
border_color = {{ base03 }}FF
background_color = {{ base00 }}E6
