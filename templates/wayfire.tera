# coat wayfire theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# THIS IS NOT A CONFIG FILE. It is a list of edits for coat to apply into the user's
# existing ~/.config/wayfire.ini, one per line:
#
#     <section>  <key>  <value>
#
# wayfire.ini has no include directive, and unlike labwc's themerc coat cannot own the
# whole file either -- it holds every keybind, plugin choice and autostart entry, all
# hand-maintained. So coat patches individual keys in place and leaves everything else,
# comments included, untouched. Keys absent from a section get appended to it; sections
# that do not exist are skipped, since that plugin is simply not enabled.
#
# `\#` and not `#`: a raw '#' STARTS A COMMENT in wayfire.ini, so an unescaped colour is
# read as an empty value and wayfire logs "invalid option value". This bites every time.
#
# No reload step is needed. wayfire watches its config file and applies changes live.
#
# Palette discipline matches the labwc and waybar templates: text is only ever base05 or
# base03 on base00, and base01/02/04/06 are avoided because plenty of schemes leave them
# at unreadable contrast. Everything below is therefore base00 grounds with base05 text.

# ── titlebars (pixdecor) ─────────────────────────────────────────────────────
# pixdecor is a third-party plugin that replaces wayfire's built-in decorator, and it is
# what gives the wayfire session rounded corners, drop shadows and left-side buttons --
# none of which the built-in one can do. Its section is [pixdecor]; the [decoration]
# keys further down are kept for the case where pixdecor is not built.
#
# fg_* is the FOCUSED window, bg_* the unfocused one (foreground/background window, not
# foreground/background colour -- worth reading twice). Unlike wayfire's built-in
# decorator, pixdecor has separate text colours for the two states, so an unfocused
# titlebar can dim its title the way labwc's does.
pixdecor  fg_color        \#{{ base00 }}ff
pixdecor  bg_color        \#{{ base00 }}cc
pixdecor  fg_text_color   \#{{ base05 }}ff
pixdecor  bg_text_color   \#{{ base03 }}ff
pixdecor  button_color    \#{{ base05 }}ff

# Black with alpha, deliberately not a palette colour: a shadow is an absence of light,
# and base00 would make it invisible on a light scheme. Same reasoning as labwc's.
pixdecor  shadow_color    \#00000080

# NOTE there are deliberately no [decoration] edits. pixdecor replaces wayfire's
# built-in decorator and `decoration` is not in the session's core/plugins, so patching
# that section would write keys nothing reads. If pixdecor ever has to be abandoned, add
# `decoration` back to core/plugins, add a [decoration] section, and restore the
# active_color/inactive_color/font_color edits here.

# ── exposé / mission control ─────────────────────────────────────────────────
# The scale overlay dims the desktop behind the spread windows, so it wants the
# background at high alpha rather than opaque.
scale  bg_color    \#{{ base00 }}e6
scale  text_color  \#{{ base05 }}ff

# The gaps between workspaces in the expo grid and during a vswitch slide. Same ground
# as everything else so a workspace switch does not flash a foreign colour.
expo     background  \#{{ base00 }}ff
vswitch  background  \#{{ base00 }}ff

# ── compositor ground ────────────────────────────────────────────────────────
# What is painted where no surface covers the output: behind a smaller wallpaper, and
# for the moment before swaybg starts.
core  background_color  \#{{ base00 }}ff
