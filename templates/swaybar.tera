# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# swaybar (sway's built-in bar) — status line comes from swayrbar.
#
# The *whole* bar block lives here, not just the colors: sway rejects `include`
# inside a bar { } block, so a colors-only fragment cannot be spliced in. Pull
# it into the session with this line in ~/.config/sway/config:
#
#     include ~/.config/sway/coat-bar

bar {
    id bar-0
    position top
{% if font_monospace %}    font pango:{{ font_monospace }} {{ font_size_desktop }}
{% endif %}    status_command swayrbar

    status_padding 3
    status_edge_padding 8
    tray_padding 3
    workspace_min_width 22
    separator_symbol "  "
    wrap_scroll no

    colors {
        background #{{ base00 }}
        statusline #{{ base05 }}
        separator  #{{ base03 }}

        focused_background #{{ base00 }}
        focused_statusline #{{ base05 }}
        focused_separator  #{{ base03 }}

        # <border> <background> <text>
        # Backgrounds stay at base00 on purpose: workspaces render as bare
        # accent-colored numbers rather than filled pills.
        focused_workspace  #{{ base00 }} #{{ base00 }} #{{ base0D }}
        active_workspace   #{{ base00 }} #{{ base00 }} #{{ base05 }}
        inactive_workspace #{{ base00 }} #{{ base00 }} #{{ base03 }}
        urgent_workspace   #{{ base00 }} #{{ base00 }} #{{ base08 }}
        binding_mode       #{{ base00 }} #{{ base00 }} #{{ base0A }}
    }
}
