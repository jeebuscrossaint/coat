/* coat theme: {{ scheme_name }}
 * {{ scheme_author }}
{% if scheme_variant %} * variant: {{ scheme_variant }}
{% endif %} *
 * Generated by coat -- do not edit. tsubu is configured at compile time, so
 * this header is included by config.def.h and the tree is rebuilt on apply.
 *
 * Follows the dunst module it replaces: base00 ground, base03 frame. Foreground
 * is base05 rather than dunst' base04 -- dunst dims normal notifications and
 * brightens critical ones through separate rules, and tsubu has no urgency
 * levels to key that off, so it uses the one foreground base16 guarantees is
 * legible on base00.
 */

#define COAT_THEMED 1

/* tsubu colours are 0xRRGGBBAA */
#define COAT_FG     0x{{ base05 | lower }}ff
#define COAT_BG     0x{{ base00 | lower }}{{ opacity_popups_hex }}
#define COAT_BORDER 0x{{ base03 | lower }}ff

{% if font_monospace %}#define COAT_FONT "{{ font_monospace }}:size={{ font_size_popups }}"
{% endif %}
