# coat theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# Generated by coat, pulled into ~/.config/mango/config.conf via
# `source=~/.config/mango/coat-colors.conf`. Colours only -- borders, gaps,
# effects, layouts and every bind are yours.
#
# CRITICAL: mango's parser does NOT strip trailing comments. `key=value # note`
# is a parse error ("Invalid <key> format"), not a value with a comment after it.
# Every comment here therefore sits on its own line.

# base00 -- the root/background colour, visible where no window is.
rootcolor=0x{{ base00 }}ff

# base03 for unfocused, base05 for focused: the same pairing dwl used, and the
# only two slots that are legible on base00 across every base16 scheme.
bordercolor=0x{{ base03 }}ff
focuscolor=0x{{ base05 }}ff

# base08 -- urgent.
urgentcolor=0x{{ base08 }}ff

# base0D -- the accent, for the scratchpad frame.
scratchpadcolor=0x{{ base0D }}ff

# base0B / base0E / base0C for the remaining state frames: green for
# maximize-to-screen, magenta for global, cyan for overlay.
maximizescreencolor=0x{{ base0B }}ff
globalcolor=0x{{ base0E }}ff
overlaycolor=0x{{ base0C }}ff

# Drag targets: accent at low alpha for the drop zone, base08 for the split line.
dropcolor=0x{{ base0D }}55
splitcolor=0x{{ base08 }}ff

# Shadows are pure black at partial alpha regardless of scheme -- tinting them
# with a palette colour reads as a glow rather than depth.
shadowscolor=0x00000088

# The group bar -- mango's per-window title strip, which is the nearest thing it has to a
# titlebar (it has no titlebars and no buttons, so no traffic lights). Focused gets the
# accent ground with base00 text on it; unfocused stays on base00 with dim text, which is
# the same active/inactive treatment the tag row uses.
group_bar_decorate_bg_color=0x{{ base00 }}ff
group_bar_decorate_fg_color=0x{{ base03 }}ff
group_bar_decorate_focus_bg_color=0x{{ base0D }}ff
group_bar_decorate_focus_fg_color=0x{{ base00 }}ff
group_bar_decorate_border_color=0x{{ base0D }}ff
