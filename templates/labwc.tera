# coat labwc theme: {{ scheme_name }}
# {{ scheme_author }}
{% if scheme_variant %}# variant: {{ scheme_variant }}{% endif %}
#
# Generated by coat into ~/.config/labwc/themerc -- the WHOLE file, not a fragment,
# because labwc's themerc has no include mechanism. Do not hand-edit it; edit
# templates/labwc.tera. Geometry that is not colour-dependent lives in rc.xml.
#
# The look is macOS-ish: traffic lights on the left, centred title, soft shadow,
# quiet 1px border. rc.xml sets the button ORDER and the corner radius; this file
# sets which colour each light is.
#
# Palette discipline, same as the waybar template: text is only ever base05 or
# base03 on base00. base01/02/04/06 are avoided entirely -- plenty of base16 schemes
# leave them at contrast ratios that are unreadable, and a titlebar is exactly where
# that shows. That is why the titlebar background is base00 rather than the
# "slightly lighter background" slot a theme like this would normally reach for:
# separation comes from the border and the drop shadow instead, which is also how
# current macOS does a unified titlebar.

border.width: 1

# ── traffic lights ───────────────────────────────────────────────────────────
# The buttons are close.xbm / iconify.xbm / max.xbm in ~/.config/labwc/, all three
# the same filled disc. xbm is a 1-BIT MASK, so the colour below is what actually
# makes them red/amber/green -- and it comes from the scheme, so they re-colour with
# everything else. base08/0A/0B are base16's semantic red/yellow/green, which is
# exactly what this needs.
#
# ORDER MATTERS HERE. themerc is applied top to bottom and the UNQUALIFIED
# `button.unpressed.image.color` sets every button, so it has to come FIRST and act
# as the default -- with it last it silently overwrote all three traffic lights and
# they rendered as three identical base05 discs. That is not obvious from the file:
# nothing warns, the specific keys are accepted, and the result just looks wrong.
# The unqualified line is also what colours any button the layout adds later
# (menu, shade, desk).
window.active.button.unpressed.image.color: #{{ base05 }}
window.active.button.close.unpressed.image.color: #{{ base08 }}
window.active.button.iconify.unpressed.image.color: #{{ base0A }}
window.active.button.max.unpressed.image.color: #{{ base0B }}
window.active.button.max_toggled.unpressed.image.color: #{{ base0B }}

# Pressed: the accent, so a click reads as a click on every button.
window.active.button.close.pressed.image.color: #{{ base0D }}
window.active.button.iconify.pressed.image.color: #{{ base0D }}
window.active.button.max.pressed.image.color: #{{ base0D }}

# Inactive windows grey their lights out, as macOS does -- the colour is a cue about
# WHICH window has focus, so leaving it on every window throws that away.
window.inactive.button.unpressed.image.color: #{{ base03 }}
window.inactive.button.close.unpressed.image.color: #{{ base03 }}
window.inactive.button.iconify.unpressed.image.color: #{{ base03 }}
window.inactive.button.max.unpressed.image.color: #{{ base03 }}

# ...and reveal it on hover, which is the other half of that macOS behaviour: it
# tells you the buttons are live before you commit to clicking.
window.inactive.button.close.hover.image.color: #{{ base08 }}
window.inactive.button.iconify.hover.image.color: #{{ base0A }}
window.inactive.button.max.hover.image.color: #{{ base0B }}

# A dim halo behind the hovered button. Alpha (#rrggbbaa) so it reads as a wash over
# the titlebar rather than a solid chip; rc.xml has no say here, the radius is below.
window.button.hover.bg.color: #{{ base03 }}55

# ── titlebar ─────────────────────────────────────────────────────────────────
window.active.title.bg: Solid
window.active.title.bg.color: #{{ base00 }}
window.active.label.text.color: #{{ base05 }}
# 1px of accent is the focus indicator, matching mango's focuscolor border.
window.active.border.color: #{{ base0D }}

window.inactive.title.bg: Solid
window.inactive.title.bg.color: #{{ base00 }}
window.inactive.label.text.color: #{{ base03 }}
window.inactive.border.color: #{{ base03 }}

# Centred, which is most of the macOS impression.
window.label.text.justify: Center

# Button box and titlebar padding. The discs are 13px; a 22px box gives them room
# without the titlebar getting tall, and a corner-radius of half the height makes the
# hover halo a circle instead of a rounded square.
window.button.width: 22
window.button.height: 22
window.button.spacing: 6
window.button.hover.bg.corner-radius: 11
window.titlebar.padding.width: 8
window.titlebar.padding.height: 3

# ── shadow ───────────────────────────────────────────────────────────────────
# Deliberately black-with-alpha and NOT a palette colour. A shadow is an absence of
# light, not a hue: base00 would make it invisible on any light scheme, and an accent
# shadow reads as a glow. rc.xml decides whether shadows are drawn at all.
window.active.shadow.size: 28
window.active.shadow.color: #00000055
window.inactive.shadow.size: 14
window.inactive.shadow.color: #00000033

# ── root menu ────────────────────────────────────────────────────────────────
menu.items.bg.color: #{{ base00 }}
menu.items.text.color: #{{ base05 }}
menu.items.active.bg.color: #{{ base0D }}
menu.items.active.text.color: #{{ base00 }}
menu.items.padding.x: 10
menu.items.padding.y: 5
menu.title.bg.color: #{{ base00 }}
menu.title.text.color: #{{ base03 }}
menu.title.text.justify: Left
menu.separator.color: #{{ base03 }}
menu.separator.width: 1
menu.separator.padding.width: 8
menu.separator.padding.height: 4
menu.border.width: 1
menu.border.color: #{{ base03 }}
menu.width.min: 140
menu.width.max: 400

# ── on-screen displays ───────────────────────────────────────────────────────
# The desktop-switch popup and the Alt-Tab switcher.
osd.bg.color: #{{ base00 }}
osd.border.color: #{{ base0D }}
osd.border.width: 1
osd.label.text.color: #{{ base05 }}

osd.window-switcher.preview.border.color: #{{ base0D }}
osd.window-switcher.preview.border.width: 2
osd.window-switcher.style-classic.item.active.bg.color: #{{ base0D }}
osd.window-switcher.style-classic.item.active.border.color: #{{ base0D }}
osd.window-switcher.style-classic.item.active.border.width: 1
osd.window-switcher.style-classic.item.padding.x: 10
osd.window-switcher.style-classic.item.padding.y: 4

# ── snap overlay ─────────────────────────────────────────────────────────────
# The preview drawn while dragging a window to an edge or a named region. Snapping is
# how tiling is done in this session, so this is worth theming properly rather than
# leaving on labwc's defaults.
snapping.overlay.region.bg.enabled: yes
snapping.overlay.region.bg.color: #{{ base0D }}40
snapping.overlay.region.border.enabled: yes
snapping.overlay.region.border.color: #{{ base0D }}
snapping.overlay.region.border.width: 2
snapping.overlay.edge.bg.enabled: yes
snapping.overlay.edge.bg.color: #{{ base0D }}40
snapping.overlay.edge.border.enabled: yes
snapping.overlay.edge.border.color: #{{ base0D }}
snapping.overlay.edge.border.width: 2

# ── magnifier ────────────────────────────────────────────────────────────────
magnifier.border.color: #{{ base0D }}
magnifier.border.width: 2
