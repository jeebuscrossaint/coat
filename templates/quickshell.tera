{#- coat -> quickshell. Emitted as JSON rather than as a QML singleton on
    purpose: QML source is only re-read when the shell reloads, but a JSON file
    can be watched. The shell's Colours singleton holds a FileView with
    watchChanges on this path, so `coat apply` repaints a running shell with no
    restart at all -- the only app in the setup that manages that.

    Every consumer must therefore tolerate this file being absent or truncated
    mid-write; Colours.qml carries a full fallback palette for exactly that. #}
{
  "_comment": "GENERATED BY COAT -- edits are overwritten by `coat apply`.",
  "scheme": {
    "name": "{{ scheme_name }}",
    "author": "{{ scheme_author }}",
    "variant": "{{ scheme_variant }}",
    "isDark": {{ is_dark }}
  },

  {#- Slots stay slots. They are handed over literally and never remapped to
      "fix" an off-coloured accent -- picking a different slot because 0D looks
      wrong in one scheme silently breaks every other scheme. #}
  "colours": {
    "base00": "#{{ base00 }}",
    "base01": "#{{ base01 }}",
    "base02": "#{{ base02 }}",
    "base03": "#{{ base03 }}",
    "base04": "#{{ base04 }}",
    "base05": "#{{ base05 }}",
    "base06": "#{{ base06 }}",
    "base07": "#{{ base07 }}",
    "base08": "#{{ base08 }}",
    "base09": "#{{ base09 }}",
    "base0A": "#{{ base0A }}",
    "base0B": "#{{ base0B }}",
    "base0C": "#{{ base0C }}",
    "base0D": "#{{ base0D }}",
    "base0E": "#{{ base0E }}",
    "base0F": "#{{ base0F }}"
  },

  {#- Semantic names are the only thing the widgets are allowed to reference, so
      the base01/02/04/06 rule is enforced here once instead of at every call
      site: those four sit at unreadable contrast in a large share of base16
      schemes and are deliberately absent below. Text is base05 or base03 on
      base00, full stop. #}
  "role": {
    "bg":        "#{{ base00 }}",
    "fg":        "#{{ base05 }}",
    "dim":       "#{{ base03 }}",
    "accent":    "#{{ base0D }}",
    "error":     "#{{ base08 }}",
    "warning":   "#{{ base0A }}",
    "success":   "#{{ base0B }}",
    "shadow":    "#{{ shadow }}"
  },

  {#- Separated channels because QML's Qt.rgba() takes floats and building a
      translucent tint from a hex string in JS on every binding is wasteful. #}
  "bgRgb": { "r": {{ base00 | r }}, "g": {{ base00 | g }}, "b": {{ base00 | b }} },
  "fgRgb": { "r": {{ base05 | r }}, "g": {{ base05 | g }}, "b": {{ base05 | b }} },

  "font": {
    "sans": "{{ font_sansserif }}",
    "mono": "{{ font_monospace }}",
    "emoji": "{{ font_emoji }}",
    "sizeDesktop": {{ font_size_desktop }},
    "sizePopup": {{ font_size_popups }}
  },

  "opacity": {
    "desktop": {{ opacity_desktop }},
    "popup": {{ opacity_popups }}
  }
}
